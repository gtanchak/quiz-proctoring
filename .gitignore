# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Turbo
.turbo/

# Vite
.vite/

# Env & secrets — never commit
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Terraform — never commit local state, provider plugins, plans, or crash logs.
# Lockfiles and committed .tfvars (no secrets) ARE tracked.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
