{
  "name": "@proctoring/core-api",
  "version": "0.0.0",
  "private": true,
  "description": "Core API: tests, attempts, users, public REST API. Authoritative for the test timer. (Fastify)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "key:create": "tsx --env-file=.env src/scripts/create-api-key.ts",
    "admin:create": "tsx --env-file=.env src/scripts/create-admin.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@proctoring/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.13",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
