# Copy to .env for local development. Never commit a real .env (see .gitignore).

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# PostgreSQL connection string (required). Matches docker-compose.yml.
DATABASE_URL=postgres://proctoring:proctoring@localhost:5432/proctoring_dev

# Reporting (PRO-26): core-api reads the violation timeline from the isolated
# violation-ingest service when assembling a per-attempt report.
VIOLATION_INGEST_URL=http://localhost:3002
# Service API key core-api presents to violation-ingest's read API. Provision a
# dedicated key from the secrets store — never commit a real value.
VIOLATION_INGEST_API_KEY=
