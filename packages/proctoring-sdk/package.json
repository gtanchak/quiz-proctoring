{
  "name": "@proctoring/proctoring-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Embeddable, framework-agnostic proctoring SDK. MUST NOT depend on React — it embeds in any host page.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@proctoring/shared": "workspace:*"
  }
}
